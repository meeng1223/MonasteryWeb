{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "monastery-web",
    "public": "dist",
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/lama-sonam-tashi", "destination": "/presidents/lama-sonam-tashi-rinpoche", "type": 301 }
    ],
    "rewrites": [
      { "source": "/about", "destination": "/index.html" },
      { "source": "/history", "destination": "/index.html" },
      { "source": "/stupa", "destination": "/index.html" },
      { "source": "/odisha-vihara", "destination": "/index.html" },
      { "source": "/dudjom-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters", "destination": "/index.html" },
      { "source": "/presidents", "destination": "/index.html" },
      { "source": "/board-members", "destination": "/index.html" },
      { "source": "/shedra", "destination": "/index.html" },
      { "source": "/graduate-monks", "destination": "/index.html" },
      { "source": "/puja", "destination": "/index.html" },
      { "source": "/prayer-books", "destination": "/index.html" },
      { "source": "/community-support", "destination": "/index.html" },
      { "source": "/support", "destination": "/index.html" },
      { "source": "/support-young-monks", "destination": "/index.html" },
      { "source": "/offering", "destination": "/index.html" },
      { "source": "/hostel-project", "destination": "/index.html" },
      { "source": "/expenditures", "destination": "/index.html" },
      { "source": "/news", "destination": "/index.html" },
      { "source": "/magazine", "destination": "/index.html" },
      { "source": "/publications", "destination": "/index.html" },
      { "source": "/gallery", "destination": "/index.html" },
      { "source": "/apps", "destination": "/index.html" },
      { "source": "/contact", "destination": "/index.html" },
      { "source": "/terms", "destination": "/index.html" },
      { "source": "/privacy", "destination": "/index.html" },
      { "source": "/vajra-masters/chagdud-tulku-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/kongtul-tsephel-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/lama-sherab-dorje-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/khenchen-tulku-shekar-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/lama-dorje-namgyal-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/lama-jamphel-sherap-rinpoche", "destination": "/index.html" },
      { "source": "/vajra-masters/lama-kelsang-nyima-rinpoche", "destination": "/index.html" },
      { "source": "/presidents/chagdud-tulku-rinpoche", "destination": "/index.html" },
      { "source": "/presidents/kongtul-tsephel-rinpoche", "destination": "/index.html" },
      { "source": "/presidents/lama-sonam-tashi-rinpoche", "destination": "/index.html" },
      { "source": "/news/*", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/admin/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), browsing-topics=()" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
